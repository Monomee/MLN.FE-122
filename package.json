{
  "name": "mln122-study-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "check:domain": "node scripts/check-domain.cjs",
    "check:domain-types": "tsc -p tsconfig.domain.json",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "react": "^19.2.0", "react-dom": "^19.2.0", "react-router-dom": "^7.9.5",
    "zustand": "^5.0.8", "dexie": "^4.2.1", "recharts": "^3.3.0", "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0", "vite": "^7.2.0", "typescript": "^5.9.3",
    "tailwindcss": "^4.1.16", "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^19.2.2", "@types/react-dom": "^19.2.2", "@types/node": "^24.10.0",
    "vitest": "^4.0.6", "jsdom": "^27.1.0", "fake-indexeddb": "^6.2.4",
    "@testing-library/react": "^16.3.0", "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1", "@playwright/test": "^1.56.1"
  },
  "engines": { "node": ">=22.12.0" }
}
